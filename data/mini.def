VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN mini_test ;
UNITS DISTANCE MICRONS 1000 ;

DIEAREA ( 0 0 ) ( 2000 2000 ) ;

COMPONENTS 3 ;
  - U1 INVX1 + PLACED ( 100 100 ) N ;
  - U2 NAND2X1 + PLACED ( 300 200 ) N ;
  - U3 BUFX2 + PLACED ( 500 200 ) FS ;
END COMPONENTS ;

PINS 2 ;
  - IN1 + NET net_in + DIRECTION INPUT + PLACED ( 100 50 ) N ;
  - OUT1 + NET net_out + DIRECTION OUTPUT + PLACED ( 800 300 ) S ;
END PINS ;

NETS 2 ;
  - net_in
    ( IN1 ) ( U1 A ) ;
  - net_out
    ( U1 Y ) ( U2 A ) ( U3 A ) ( OUT1 ) ;
END NETS ;

END DESIGN
